{
  "name": "anti-debugger",
  "version": "0.3.0",
  "description": "Web反调试工具",
  "main": "./dist/index.umd.js",
  "files": [
    "dist"
  ],
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "ts:build": "tsc --build src/antiDebugger/tsconfig.json",
    "build": "vite --config vite.build.config.ts build --mode production",
    "cp:types": "cp -r src/antiDebugger/buildTypes dist/",
    "cp:type": "cp src/antiDebugger/buildTypes/index.d.ts dist",
    "plugin:build": "pnpm run ts:build && pnpm run build && pnpm run cp:type",
    "push:npm:package": "gulp versionPatch && gulp npmPackagePush",
    "updata:package": "npm publish --registry https://registry.npmjs.org",
    "plugin:build:push:npm:package": "pnpm run plugin:build && pnpm run push:npm:package",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,less,html,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "matias",
    "matiastang",
    "anti-debugger"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matiastang/anti-debugger.git"
  },
  "author": {
    "name": "matiastang",
    "email": "matiastang@163.com"
  },
  "packageManager": "pnpm@10.15.1",
  "license": "Apache 2.0",
  "bugs": {
    "url": "https://github.com/matiastang/anti-debugger/issues"
  },
  "homepage": "https://github.com/matiastang/anti-debugger#readme",
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@playwright/test": "^1.62.1",
    "@types/gulp": "^4.0.17",
    "@types/gulp-bump": "^2.8.6",
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.14.10",
    "@types/shelljs": "^0.8.15",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/eslint-config-prettier": "^9.0.0",
    "anti-debugger": "^0.1.0",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "gulp": "4",
    "gulp-bump": "^3.2.0",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "lint-staged": "^17.3.0",
    "minimist": "^1.2.8",
    "path": "^0.12.7",
    "prettier": "3.3.3",
    "rollup": "^4.18.1",
    "rollup-plugin-terser": "^7.0.2",
    "shelljs": "^0.8.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^7.18.0",
    "vite": "^5.3.3",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^3.2.7",
    "vue": "^3.4.31",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^4.4.0",
    "vue-tsc": "^3.3.10"
  },
  "dependencies": {
    "devtools-detect": "^4.0.2",
    "devtools-detector": "^2.0.20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
